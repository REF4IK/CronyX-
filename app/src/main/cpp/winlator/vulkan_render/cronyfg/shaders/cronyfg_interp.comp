#version 450
// Bidirectional warp of the two real frames. The flow is BACKWARD (curr->prev)
// in flow pixels, so a pixel at time t samples prev at +b*t and curr at
// -b*(1-t). Low confidence, or a sample that leaves the frame, snaps to the
// nearest real frame instead of blending a wrong vector.
// A gamut (neighborhood) clamp then keeps the blend inside the colors the
// current frame actually shows around the reprojected position: this is the
// cheap anti-ghost that stops a moving object's trail bleeding through.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uFlow;
layout(set = 0, binding = 1) uniform sampler2D uPrev;
layout(set = 0, binding = 2) uniform sampler2D uCurr;
layout(set = 0, binding = 4, rgba8) uniform image2D uTarget;

layout(push_constant) uniform Push {
    vec4 dims;     // dstW, dstH, flowW, flowH
    vec4 params;   // x = t
    vec4 tune2;    // x = gamutStrength, y = confFloor, z = sharpen
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst = ivec2(pc.dims.xy);
    if (p.x >= dst.x || p.y >= dst.y) return;

    vec2 dstSize = pc.dims.xy;
    vec2 flowSize = pc.dims.zw;
    vec2 uv = (vec2(p) + 0.5) / dstSize;

    vec4 f = texture(uFlow, uv);
    vec2 b = f.xy;
    float conf = clamp(f.w, 0.0, 1.0);
    float t = clamp(pc.params.x, 0.0, 1.0);

    vec2 uvPrev = uv + b * (t / flowSize);
    vec2 uvCurr = uv - b * ((1.0 - t) / flowSize);

    bool inPrev = all(greaterThanEqual(uvPrev, vec2(0.0))) &&
                  all(lessThanEqual(uvPrev, vec2(1.0)));
    bool inCurr = all(greaterThanEqual(uvCurr, vec2(0.0))) &&
                  all(lessThanEqual(uvCurr, vec2(1.0)));

    vec3 prev = texture(uPrev, clamp(uvPrev, vec2(0.0), vec2(1.0))).rgb;
    vec3 curr = texture(uCurr, clamp(uvCurr, vec2(0.0), vec2(1.0))).rgb;

    vec3 blended = prev * (1.0 - t) + curr * t;

    // Gamut clamp (5-tap cross around the reprojected current-frame position).
    // The warped blend of a moving edge can fall outside what curr shows here;
    // pulling it back into [min,max] removes the ghost trail. Only trust the
    // range when the current-frame sample is actually on screen.
    if (inCurr) {
        vec2 e = 1.0 / dstSize;
        vec2 c = clamp(uvCurr, vec2(0.0), vec2(1.0));
        vec3 n1 = texture(uCurr, clamp(c + vec2(-e.x, 0.0), vec2(0.0), vec2(1.0))).rgb;
        vec3 n2 = texture(uCurr, clamp(c + vec2( e.x, 0.0), vec2(0.0), vec2(1.0))).rgb;
        vec3 n3 = texture(uCurr, clamp(c + vec2(0.0, -e.y), vec2(0.0), vec2(1.0))).rgb;
        vec3 n4 = texture(uCurr, clamp(c + vec2(0.0,  e.y), vec2(0.0), vec2(1.0))).rgb;
        vec3 mn = min(min(min(curr, n1), min(n2, n3)), n4);
        vec3 mx = max(max(max(curr, n1), max(n2, n3)), n4);
        // «Ultra»: линейное усреднение двух репроецированных кадров размывает
        // деталь — на 3x/4x почти весь экран синтетический, отсюда «мыло».
        // Возвращаем микроконтраст, подмешивая высокочастотную составляющую
        // РЕАЛЬНОГО текущего кадра (её крест-соседей уже берём для гаммы — ноль
        // доп. выборок, нагрузку не поднимаем). Призрака эта деталь не добавляет,
        // т.к. взята из настоящего кадра, а не из среднего двух.
        vec3 detail = curr - (n1 + n2 + n3 + n4) * 0.25;
        blended += pc.tune2.z * detail;
        // Гамут-зажим ПОСЛЕ резкости: поднимает чёткость, но не даёт усилить ghost
        // за пределы реально видимых вокруг цветов.
        blended = mix(blended, clamp(blended, mn, mx), pc.tune2.x);
    }

    vec3 nearest = (t < 0.5) ? prev : curr;
    // confFloor (из пресета) не даёт blend полностью схлопнуться в ближайший
    // реальный кадр на сильных пресетах: иначе движение «застывает» на окклюзии.
    float useBlend = max(conf, pc.tune2.y);

    // NOTE: no pixel-diff "photometric consistency" gate here. Comparing the two
    // warped real frames flags exactly the high-motion pixels we are supposed to
    // interpolate as "occlusion", which snaps them to a real frame and kills
    // smoothness (and makes Flow Scale irrelevant). Occlusion is better handled by
    // the search confidence and the gamut clamp above; a true forward/backward
    // round-trip test needs an actual forward pass, not a color diff.
    if (!inPrev) { blended = curr; nearest = curr; useBlend = 1.0; }
    if (!inCurr) { blended = prev; nearest = prev; useBlend = 1.0; }

    vec3 color = mix(nearest, blended, useBlend);

    // Сохранение статики/HUD (пункт 4.3 плана). Сравниваем ДВА РЕАЛЬНЫХ кадра в
    // самой экранной позиции uv (без репроекции). Если они совпадают — пиксель
    // статичен (HUD, прицел, меню, субтитры, неподвижный фон): правильное
    // промежуточное значение есть этот же реальный цвет, а репроекция по потоку
    // (загрязнённому соседним движением в блоке) может его только размазать.
    // Движущийся пиксель между кадрами различается -> маска 0 -> обычная
    // интерполяция. Порог жёсткий (порядка 1..5/255): под маску попадает только
    // настоящая статика, зерно/TAA-мерцание — нет. В отличие от фотометрического
    // гейта окклюзии это НИКОГО не наказывает по движению.
    vec3 sPrev = texture(uPrev, uv).rgb;
    vec3 sCurr = texture(uCurr, uv).rgb;
    float sdiff = max(abs(sCurr.r - sPrev.r),
                      max(abs(sCurr.g - sPrev.g), abs(sCurr.b - sPrev.b)));
    float staticMask = 1.0 - smoothstep(0.004, 0.02, sdiff);
    color = mix(color, sCurr, staticMask);

    imageStore(uTarget, p, vec4(color, 1.0));
}
